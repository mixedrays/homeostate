{
  "name": "@homeostate/store-redux",
  "version": "0.1.2",
  "description": "Redux adapter for @homeostate/core",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixedrays/homeostate.git",
    "directory": "packages/store-redux"
  },
  "homepage": "https://homeostate.pages.dev",
  "bugs": {
