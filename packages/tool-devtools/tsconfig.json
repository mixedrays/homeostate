{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    // Vite bundles the JavaScript so the compiled stylesheet can be inlined; tsc only
    // writes the declarations next to it.
    "emitDeclarationOnly": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__"],
  "references": [{ "path": "../core" }]
}
