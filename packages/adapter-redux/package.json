{
  "name": "@homeostate/adapter-redux",
  "version": "0.1.0",
  "description": "Redux adapter for @homeostate/core",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@homeostate/core": "workspace:^"
  },
  "peerDependencies": {
    "redux": "^5.0.0"
  },
  "devDependencies": {
    "redux": "^5.0.1"
  }
}
