{
  "name": "@homeostate/persist-indexeddb",
  "version": "0.1.0",
  "description": "IndexedDB persistence adapter for @homeostate/core",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixedrays/homeostate.git",
    "directory": "packages/persist-indexeddb"
  },
  "homepage": "https://homeostate.pages.dev",
  "bugs": {
    "url": "https://github.com/mixedrays/homeostate/issues"
  },
  "keywords": [
    "indexeddb",
    "persistence",
    "offline",
    "crdt",
    "sync",
    "state-management"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@homeostate/core": "workspace:^"
  },
  "devDependencies": {
    "@homeostate/crdt-yjs": "workspace:^",
    "fake-indexeddb": "^6.2.5",
    "yjs": "^13.6.27"
  }
}
