{
  "name": "@homeostate/tool-simulator",
  "version": "0.0.0",
  "description": "Test homeostate peers on a simulated network with latency, drops, reordering and partitions, and check that they converge",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixedrays/homeostate.git",
    "directory": "packages/tool-simulator"
  },
  "homepage": "https://homeostate.pages.dev",
  "bugs": {
    "url": "https://github.com/mixedrays/homeostate/issues"
  },
  "keywords": [
    "testing",
    "simulation",
    "network",
    "convergence",
    "crdt",
    "sync",
    "state-management"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@homeostate/core": "workspace:^"
  },
  "devDependencies": {
    "@automerge/automerge": "^3.4.1",
    "@homeostate/crdt-automerge": "workspace:^",
    "@homeostate/crdt-loro": "workspace:^",
    "@homeostate/crdt-yjs": "workspace:^",
    "@homeostate/store-zustand": "workspace:^",
    "loro-crdt": "^1.16.1",
    "yjs": "^13.6.23",
    "zustand": "^4.5.2"
  }
}
