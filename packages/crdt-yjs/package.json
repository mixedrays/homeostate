{
  "name": "@homeostate/crdt-yjs",
  "version": "0.1.3",
  "description": "Yjs CRDT backend for @homeostate/core",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mixedrays/homeostate.git",
    "directory": "packages/crdt-yjs"
  },
  "homepage": "https://homeostate.pages.dev",
  "bugs": {
    "url": "https://github.com/mixedrays/homeostate/issues"
  },
  "keywords": [
    "yjs",
    "crdt",
    "sync",
    "state-management",
    "collaborative"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@homeostate/core": "workspace:^"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "yjs": "^13.6.23"
  }
}
